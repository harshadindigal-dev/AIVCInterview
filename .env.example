# Copy to .env and fill in OPENROUTER_API_KEY. Everything else has a sensible default.

# Only "live" is supported in this build (see DECISIONS.md D1).
LLM_MODE=live

# Required. https://openrouter.ai/keys  First start seeds 50 enquiries (~$2 with the default model).
OPENROUTER_API_KEY=

# OpenRouter slugs (vendor/model).
TRIAGE_MODEL=anthropic/claude-sonnet-5.5
EVAL_MODELS=anthropic/claude-haiku-5.5,google/gemini-3.8-flash
# Fallback model(s) passed in OpenRouter's `models` array for the app pipeline (not used by eval).
TRIAGE_FALLBACK_MODELS=google/gemini-3.8-flash

# Sent as HTTP-Referer / X-Title so usage is attributed in the OpenRouter dashboard;
# the URL is also the base for Accept/Reassign links in notifications.
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME=Intake Triage Demo

# Inside Docker the database lives on the `appdata` volume.
DATABASE_URL=sqlite:////app/var/app.db
